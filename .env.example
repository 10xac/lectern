# Copy to .env (never commit .env). Everything is optional: the default provider is "fake",
# which needs no key and no network.

# fake | anthropic | openai_compat
LECTERN_PROVIDER=fake
# Only for the real providers:
LECTERN_API_KEY=
LECTERN_MODEL=
# Optional; defaults: https://api.anthropic.com (anthropic), https://openrouter.ai/api/v1 (openai_compat)
LECTERN_BASE_URL=

# Models a request may pick for its agent, as provider:model, comma-separated (fake is always allowed)
LECTERN_MODEL_ALLOWLIST=

# SQLite file used by `make dev` and the CLI
LECTERN_DB=lectern.db

# v0.2 (all optional)
# Files (slides, uploads, references): a folder, or s3://bucket/prefix (needs `uv sync --extra s3`
# and the usual AWS_* variables; AWS_ENDPOINT_URL for MinIO or R2)
LECTERN_BLOBS=lectern-blobs
# The web researcher (Exa)
EXA_API_KEY=
# jev triage over OpenRouter's decisions endpoint (model override: LECTERN_JEV_MODEL). Not needed when
# the main provider is already OpenRouter: LECTERN_API_KEY is reused (decision D9).
OPENROUTER_API_KEY=
# System1 (triage's fast model), only to override what is inferred from the main provider:
# openrouter | openai | google | anthropic | openai_compat
SYSTEM1_MODEL_PROVIDER=
SYSTEM1_API_KEY=
SYSTEM1_MODEL_NAME=
SYSTEM1_BASE_URL=
# Login: LECTERN_AUTH=1 (or LECTERN_PUBLIC=1) requires a user session for the API and a personal access
# token for /mcp. Seed the first admin with `lectern users create-admin <email>`.
LECTERN_AUTH=
LECTERN_PUBLIC_URL=
# Encrypts the API keys admins store in the web app (Fernet key; see deploy/README.md)
LECTERN_SECRET_KEY=

# Deployment (see deploy/README.md)
# LECTERN_PUBLIC=1 turns login on (deploy/compose.yml sets it)
LECTERN_HOSTS=
LECTERN_PORT=8790
LECTERN_MAX_ASKS_PER_DAY=200
LECTERN_ASKS_PER_MINUTE=10
LECTERN_UPLOADS_PER_MINUTE=20
LECTERN_MAX_UPLOAD_MB=20
